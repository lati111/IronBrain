[
    {
        "version": "2.2.0",
        "date": "2026-11-18",
        "modules": {
            "Core": {
                "General": [
                    "Added a changelog page listing the updates made to the website",
                    {
                        "text": "Packages are now updated for security fixes",
                        "permission": "admin"
                    }
                ]
            },
            "DnD": {
                "Fantasy Timeline": {
                    "permission": "dnd_timeline.access",
                    "changes": [
                        "Added the new Fantasy Timeline module"
                    ]
                },
                "Restaurant Simulator": {
                    "permission": "dnd_restaurant.access",
                    "changes": [
                        "Unknown customers now have their names hidden by default, until the owner reveals them",
                        "Customers now tip automatically based upon the satisfaction level, with their own expectation, rate and cap",
                        "Meal quality now depends on how well the cookers are attended, with meals that nobody cooks losing quality",
                        "Equipment now adds a quality bonus and multiplier to the meals made with it",
                        "Boosts now also affect the quality of meals",
                        "Cooks now prep at half speed while they also look after the cookers",
                        "Seating a customer now immediately sends the waiter to take their order, combining serving and taking an order into one flow",
                        "Players with the service page open now count as online"
                    ]
                }
            }
        }
    },
